{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="page-content home greigh-home">
	<style>
		.greigh-home {
			padding: 48px 16px 80px;
			min-height: calc(100vh - 140px);
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
		}
		.greigh-container {
			max-width: 960px;
			width: 100%;
			margin: 0 auto;
			text-align: center;
		}
		.greigh-hero-badge {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 6px 14px;
			border-radius: 9999px;
			font-size: 0.8rem;
			font-weight: 500;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			background: var(--color-box-header, rgba(255, 255, 255, 0.04));
			border: 1px solid var(--color-secondary, rgba(255, 255, 255, 0.1));
			color: var(--color-text-light-2, #a1a1aa);
			margin-bottom: 24px;
		}
		.greigh-hero-badge .dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: #22c55e;
			box-shadow: 0 0 8px #22c55e;
		}
		.greigh-logo-wrap {
			margin-bottom: 20px;
			display: flex;
			justify-content: center;
		}
		.greigh-logo-img {
			width: 96px;
			height: 96px;
			object-fit: contain;
			filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.4));
			transition: transform 0.3s ease;
		}
		.greigh-logo-img:hover {
			transform: scale(1.05);
		}
		.greigh-title {
			font-size: 2.75rem;
			font-weight: 700;
			letter-spacing: -0.02em;
			color: var(--color-text, #fafafa);
			margin: 0 0 12px;
			line-height: 1.15;
		}
		.greigh-tagline {
			font-size: 1.25rem;
			color: var(--color-text-light-1, #d4d4d8);
			max-width: 620px;
			margin: 0 auto 16px;
			line-height: 1.5;
			font-weight: 400;
		}
		.greigh-desc {
			font-size: 0.95rem;
			color: var(--color-text-light-3, #71717a);
			max-width: 680px;
			margin: 0 auto 36px;
			line-height: 1.6;
		}
		.greigh-actions {
			display: flex;
			gap: 14px;
			justify-content: center;
			flex-wrap: wrap;
			margin-bottom: 56px;
		}
		.greigh-btn {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 12px 24px;
			border-radius: 8px;
			font-size: 0.95rem;
			font-weight: 600;
			text-decoration: none !important;
			transition: all 0.2s ease;
		}
		.greigh-btn-primary {
			background: var(--color-primary, #3b82f6);
			color: #ffffff !important;
			border: 1px solid transparent;
		}
		.greigh-btn-primary:hover {
			background: var(--color-primary-dark-1, #2563eb);
			transform: translateY(-1px);
			box-shadow: 0 4px 14px rgba(59, 130, 246, 0.3);
		}
		.greigh-btn-secondary {
			background: var(--color-box-header, rgba(255, 255, 255, 0.05));
			color: var(--color-text, #fafafa) !important;
			border: 1px solid var(--color-secondary, rgba(255, 255, 255, 0.12));
		}
		.greigh-btn-secondary:hover {
			background: var(--color-hover, rgba(255, 255, 255, 0.1));
			border-color: var(--color-secondary-dark-1, rgba(255, 255, 255, 0.2));
			transform: translateY(-1px);
		}
		.greigh-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 20px;
			text-align: left;
			margin-top: 10px;
		}
		.greigh-card {
			background: var(--color-box-body, rgba(255, 255, 255, 0.02));
			border: 1px solid var(--color-secondary, rgba(255, 255, 255, 0.08));
			border-radius: 12px;
			padding: 24px;
			transition: all 0.2s ease;
		}
		.greigh-card:hover {
			border-color: var(--color-secondary-dark-1, rgba(255, 255, 255, 0.18));
			transform: translateY(-2px);
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
		}
		.greigh-card-header {
			display: flex;
			align-items: center;
			gap: 10px;
			margin-bottom: 10px;
		}
		.greigh-card-icon {
			width: 20px;
			height: 20px;
			color: var(--color-primary, #60a5fa);
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.greigh-card-title {
			font-size: 1.05rem;
			font-weight: 600;
			color: var(--color-text, #fafafa);
			margin: 0;
		}
		.greigh-card-text {
			font-size: 0.88rem;
			color: var(--color-text-light-2, #a1a1aa);
			line-height: 1.55;
			margin: 0;
		}
		.greigh-card-link {
			display: inline-block;
			margin-top: 14px;
			font-size: 0.84rem;
			font-weight: 500;
			color: var(--color-primary, #60a5fa) !important;
		}
		.greigh-card-link:hover {
			text-decoration: underline !important;
		}
	</style>

	<div class="greigh-container">
		<div class="greigh-hero-badge">
			<span class="dot"></span>
			<span>Greigh Studios Internal Infrastructure</span>
		</div>

		<div class="greigh-logo-wrap">
			<img class="greigh-logo-img" src="{{AssetUrlPrefix}}/img/logo.svg" alt="Greigh Studios">
		</div>

		<h1 class="greigh-title">Greigh Studios Git</h1>
		<p class="greigh-tagline">Internal source control, build systems, and collaborative engineering artifacts.</p>
		<p class="greigh-desc">
			This instance is dedicated exclusively to Greigh Studios LLC design, development, and client project deliverables.
			Public self-registration is disabled; access is limited to authorized studio personnel and invited partners.
		</p>

		<div class="greigh-actions">
			{{if .IsSigned}}
				<a class="greigh-btn greigh-btn-primary" href="{{AppSubUrl}}/greighstudios">
					{{svg "octicon-organization" 16}}
					<span>Greigh Studios Org</span>
				</a>
				<a class="greigh-btn greigh-btn-secondary" href="{{AppSubUrl}}/explore/repos">
					{{svg "octicon-repo" 16}}
					<span>Explore Repos</span>
				</a>
				<a class="greigh-btn greigh-btn-secondary" href="{{AppSubUrl}}/repo/create">
					{{svg "octicon-plus" 16}}
					<span>New Repository</span>
				</a>
			{{else}}
				<a class="greigh-btn greigh-btn-primary" href="{{AppSubUrl}}/greighstudios">
					{{svg "octicon-organization" 16}}
					<span>Greigh Studios Organization</span>
				</a>
				<a class="greigh-btn greigh-btn-secondary" href="{{AppSubUrl}}/explore/repos">
					{{svg "octicon-repo" 16}}
					<span>Browse Repositories</span>
				</a>
				<a class="greigh-btn greigh-btn-secondary" href="{{AppSubUrl}}/user/login">
					{{svg "octicon-sign-in" 16}}
					<span>Sign In</span>
				</a>
			{{end}}
		</div>

		<div class="greigh-grid">
			<div class="greigh-card">
				<div class="greigh-card-header">
					<span class="greigh-card-icon">{{svg "octicon-organization" 18}}</span>
					<h3 class="greigh-card-title">Studio Organization</h3>
				</div>
				<p class="greigh-card-text">
					Explore official project repositories, web applications, and packages maintained by Greigh Studios.
				</p>
				<a class="greigh-card-link" href="{{AppSubUrl}}/greighstudios">View @greighstudios &rarr;</a>
			</div>

			<div class="greigh-card">
				<div class="greigh-card-header">
					<span class="greigh-card-icon">{{svg "octicon-lock" 18}}</span>
					<h3 class="greigh-card-title">Authorized Access Only</h3>
				</div>
				<p class="greigh-card-text">
					All accounts and organizational permissions are provisioned by studio administrators. Self-registration is closed.
				</p>
				<a class="greigh-card-link" href="{{AppSubUrl}}/user/login">Team Sign In &rarr;</a>
			</div>

			<div class="greigh-card">
				<div class="greigh-card-header">
					<span class="greigh-card-icon">{{svg "octicon-globe" 18}}</span>
					<h3 class="greigh-card-title">Studio Website</h3>
				</div>
				<p class="greigh-card-text">
					Return to the primary Greigh Studios portfolio for design case studies, client services, and studio inquiries.
				</p>
				<a class="greigh-card-link" href="https://greighstudios.com" target="_blank" rel="noopener noreferrer">greighstudios.com &rarr;</a>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
