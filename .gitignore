# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# deploy + mail secrets (never commit)
deploy/.env.deploy
mail-server-logins.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI Helpers
.claude
# CLAUDE.md / AGENTS.md are intentionally tracked: next dev regenerates
# AGENTS.md on every run, so committing it is what keeps the tree clean.
# They were listed here but already in the index, so the rule did nothing.

# Brand Assets
/brand-assets
# Local-only maintainer runbook (contains infra details)
deploy/PROVISION.md
