# Contact form — sends through the VPS mail server (Postfix/Dovecot).
# These are read at runtime by src/app/api/contact/route.ts.
# On the server they live in .env.production (never committed).

SMTP_HOST=mail.greighstudios.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@greighstudios.com
SMTP_PASS=

# Where inquiries are delivered, and the From header the site sends as.
CONTACT_TO=hello@greighstudios.com
CONTACT_FROM=Greigh Studios <hello@greighstudios.com>
